generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  codigoEstudiante String   @id
  nombre           String
  apellido         String
  idGrado          Int
  grupo            String?
  correo           String?
  fotoUrl          String?
  estado           String   @default("activo")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  grade            Grade              @relation(fields: [idGrado], references: [idGrado])
  studentSchedules StudentSchedule[]
  attendances      AttendanceRecord[]
  supervisorStays  SupervisorStay[]
  studentTransfers StudentTransfer[]

  @@index([idGrado])
  @@index([nombre, apellido])
}

model Discipline {
  codigoDisciplina String   @id
  nombre           String
  descripcion      String?
  estado           String   @default("activa")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentSchedules       StudentSchedule[]
  assignments            ExtracurricularAssignment[]

  @@index([nombre])
}

model StudentSchedule {
  id               String   @id @default(uuid())
  codigoEstudiante String
  codigoDisciplina String
  diaSemana        String
  createdAt        DateTime @default(now())

  student    Student    @relation(fields: [codigoEstudiante], references: [codigoEstudiante], onDelete: Cascade)
  discipline Discipline @relation(fields: [codigoDisciplina], references: [codigoDisciplina])

  @@unique([codigoEstudiante, diaSemana])
  @@index([codigoEstudiante])
  @@index([codigoDisciplina])
  @@index([diaSemana])
}

model Teacher {
  idProfesor      String   @id @default(uuid())
  codigoProfesor  String?  @unique
  nombre          String
  apellido        String
  correo          String?  @unique
  fotoUrl         String?
  passwordHash    String?
  estado          String   @default("activo")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments          ExtracurricularAssignment[]
  sessions             ClassSession[]
  refreshTokens        TeacherRefreshToken[]

  @@index([codigoProfesor])
  @@index([nombre, apellido])
}

model TeacherRefreshToken {
  id         String    @id @default(uuid())
  teacherId  String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [idProfesor], onDelete: Cascade)

  @@index([teacherId])
  @@index([familyId])
}

model Grade {
  idGrado Int    @id @default(autoincrement())
  nombre  String @unique
  nivel   String?
  estado  String @default("activo")

  students    Student[]
  assignments ExtracurricularAssignment[]
}

model Schedule {
  idHorario  String   @id @default(uuid())
  diaSemana  String
  horaInicio String?
  horaFin    String?
  aula       String?
  estado     String   @default("activo")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignmentSchedules AssignmentSchedule[]
  sessions            ClassSession[]
  stays               SupervisorStay[]
  transfersDestino    StudentTransfer[]   @relation("TransferDestino")

  @@index([diaSemana])
}

model ExtracurricularAssignment {
  idAsignacion     String   @id @default(uuid())
  idProfesor       String
  codigoDisciplina String
  idGrado          Int
  esPrincipal      Boolean  @default(false)
  estado           String   @default("activo")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacher    Teacher              @relation(fields: [idProfesor], references: [idProfesor])
  discipline Discipline           @relation(fields: [codigoDisciplina], references: [codigoDisciplina])
  grade      Grade                @relation(fields: [idGrado], references: [idGrado])
  schedules  AssignmentSchedule[]
  sessions   ClassSession[]
  stays      SupervisorStay[]
  transfersOrigen  StudentTransfer[] @relation("TransferOrigen")
  transfersDestino StudentTransfer[] @relation("TransferDestino")

  @@unique([idProfesor, codigoDisciplina, idGrado])
  @@index([codigoDisciplina])
  @@index([idGrado])
  @@index([idProfesor])
}

model AssignmentSchedule {
  id             String   @id @default(uuid())
  idAsignacion   String
  idHorario      String
  createdAt      DateTime @default(now())

  assignment ExtracurricularAssignment @relation(fields: [idAsignacion], references: [idAsignacion], onDelete: Cascade)
  schedule   Schedule                  @relation(fields: [idHorario], references: [idHorario])

  @@unique([idAsignacion, idHorario])
  @@index([idAsignacion])
  @@index([idHorario])
}

model Supervisor {
  idSupervisor     String   @id @default(uuid())
  codigoSupervisor String?  @unique
  nombre           String
  apellido         String
  correo           String?  @unique
  fotoUrl          String?
  estado           String   @default("activo")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refreshTokens SupervisorRefreshToken[]
  stays         SupervisorStay[]
  transfers     StudentTransfer[]

  @@index([codigoSupervisor])
  @@index([nombre, apellido])
}

model SupervisorRefreshToken {
  id           String    @id @default(uuid())
  supervisorId String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())

  supervisor Supervisor @relation(fields: [supervisorId], references: [idSupervisor], onDelete: Cascade)

  @@index([supervisorId])
  @@index([familyId])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nombre       String
  apellido     String
  estado       String   @default("activo")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs     AuditLog[]
  refreshTokens AdminRefreshToken[]
}

model AdminRefreshToken {
  id         String    @id @default(uuid())
  adminId    String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([familyId])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  accion     String
  entidad    String
  entidadId  String?
  detalles   Json?
  createdAt  DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entidad])
  @@index([createdAt])
}

model ClassSession {
  id             String   @id @default(uuid())
  idAsignacion   String
  idHorario      String
  fecha          DateTime
  estado         String   @default("programada")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment ExtracurricularAssignment @relation(fields: [idAsignacion], references: [idAsignacion])
  schedule   Schedule                  @relation(fields: [idHorario], references: [idHorario])
  teacher    Teacher                   @relation(fields: [idProfesor], references: [idProfesor])
  idProfesor String
  attendances AttendanceRecord[]

  @@unique([idAsignacion, idHorario, fecha])
  @@index([idProfesor])
  @@index([fecha])
  @@index([idAsignacion])
}

model AttendanceRecord {
  id               String   @id @default(uuid())
  sessionId        String
  codigoEstudiante String
  estado           String   @default("presente")
  createdAt        DateTime @default(now())

  session ClassSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [codigoEstudiante], references: [codigoEstudiante])

  @@unique([sessionId, codigoEstudiante])
  @@index([sessionId])
  @@index([codigoEstudiante])
}

model Novedad {
  id                  String    @id @default(uuid())
  novedadId           String
  archivo             String // nombre del archivo xlsx de origen
  codigoEstudiante    String
  descripcion         String? // Novedad_de_Salida_Diaria_M
  seAusentaCon        String? // Se ausenta con
  seAusentaConOtro    String? // Se ausenta con Otro
  seAusentaConTipo    String? // Se_AusentaCon_Tipo_M
  tipoNovedad         String? // Tipo de Novedad
  flujoNovedad        String? // Flujo_Novedad
  grados              String? // Grados
  nombresEstudiantes  String? // Nombres_Estudiantes
  fotoUrls            String? // Fotos (urls separadas por coma)
  fechaHora           DateTime? // FechaHora
  scanCodes           String? // ScanCode
  fechaCreacion       DateTime? // Fecha_Creacion
  registradoPor       String? // RegistradoPor
  procesado           String? // Procesado
  regresaAlColegio    Boolean @default(false) // Regresa_Al_Colegio
  horaEstimadaRegreso String? // Hora_Estimada_Regreso
  fechaNovedad        DateTime? // Fecha_Novedad
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([codigoEstudiante])
  @@index([archivo])
  @@unique([novedadId, codigoEstudiante])
}

model SupervisorStay {
  id               String   @id @default(uuid())
  idAsignacion     String
  idHorario        String
  codigoEstudiante String
  fecha            DateTime @db.Date
  idSupervisor     String
  createdAt        DateTime @default(now())

  student    Student                  @relation(fields: [codigoEstudiante], references: [codigoEstudiante])
  assignment ExtracurricularAssignment @relation(fields: [idAsignacion], references: [idAsignacion])
  schedule   Schedule                 @relation(fields: [idHorario], references: [idHorario])
  supervisor Supervisor              @relation(fields: [idSupervisor], references: [idSupervisor])

  @@unique([idAsignacion, idHorario, codigoEstudiante, fecha])
  @@index([idAsignacion, idHorario])
  @@index([codigoEstudiante])
  @@index([fecha])
}

model StudentTransfer {
  id                  String   @id @default(uuid())
  codigoEstudiante    String
  idAsignacionOrigen  String
  idAsignacionDestino String
  idHorarioDestino    String
  fecha               DateTime @db.Date
  motivo              String
  idSupervisor        String
  createdAt           DateTime @default(now())

  student          Student                  @relation(fields: [codigoEstudiante], references: [codigoEstudiante])
  assignmentOrigen  ExtracurricularAssignment @relation("TransferOrigen", fields: [idAsignacionOrigen], references: [idAsignacion])
  assignmentDestino ExtracurricularAssignment @relation("TransferDestino", fields: [idAsignacionDestino], references: [idAsignacion])
  scheduleDestino   Schedule                 @relation("TransferDestino", fields: [idHorarioDestino], references: [idHorario])
  supervisor        Supervisor               @relation(fields: [idSupervisor], references: [idSupervisor])

  @@unique([codigoEstudiante, fecha])
  @@index([idAsignacionOrigen])
  @@index([idAsignacionDestino])
  @@index([idHorarioDestino])
  @@index([idSupervisor])
  @@index([fecha])
}
