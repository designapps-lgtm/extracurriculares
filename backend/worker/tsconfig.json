{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "./worker-configuration.d.ts",
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "./worker.ts",
    "./env.ts",
    "./worker-configuration.d.ts",
    "../src/**/*.ts"
  ],
  "exclude": [
    "./node_modules",
    "../node_modules",
    "../src/test-*.ts",
    "../src/audit.ts",
    "../src/import/**/*"
  ]
}