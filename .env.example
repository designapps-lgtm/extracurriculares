# Database
POSTGRES_USER=extracurriculares
POSTGRES_PASSWORD=secret_password
POSTGRES_DB=extracurriculares

# Backend
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-secure-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_DURATION_HOURS=168

# Google OAuth (login de profesores)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_INSTITUTION_DOMAIN=gi.edu.co

# AppSheet
# Id publico de la aplicación y nombre exacto de la tabla de novedades.
APPSHEET_APP_ID=xxxx-xxxx-xxxx-xxxx
APPSHEET_NOVEDADES_TABLE=Novedades
# Token privado del webhook de AppSheet; no lo comparta ni lo suba al repositorio.
APPSHEET_NOVEDADES_WEBHOOK_TOKEN=

# Frontend
VITE_API_URL=http://localhost:3000
