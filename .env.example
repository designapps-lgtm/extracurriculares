# Backend server-only
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-server-only-secret
ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_DURATION_HOURS=168

# Google OAuth (server-only verification; same client ID may be configured in the frontend build)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_INSTITUTION_DOMAIN=gi.edu.co

# AppSheet server-only. Never expose APPSHEET_APPLICATION_ACCESS_KEY in frontend code.
APPSHEET_APP_ID=xxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPSHEET_APPLICATION_ACCESS_KEY=replace-with-a-rotated-appsheet-key
APPSHEET_DEMOGRAFICOS_TABLE=Demograficos
# Novedades are read from the separate Lector_QR AppSheet app.
APPSHEET_NOVEDADES_APP_ID=6f5cc364-a2a4-4a1b-9603-873f54374310
APPSHEET_NOVEDADES_APPLICATION_ACCESS_KEY=replace-with-a-new-lector-qr-key
APPSHEET_NOVEDADES_TABLE=Novedades_Diarias
APPSHEET_WEBHOOK_TOKEN=replace-with-webhook-token

# Optional Google Drive photo proxy/watch (server-only)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_WEBHOOK_URL=
GOOGLE_DRIVE_WEBHOOK_TOKEN=

# Frontend public build-time configuration
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
