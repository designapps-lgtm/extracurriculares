# Database
POSTGRES_USER=extracurriculares
POSTGRES_PASSWORD=secret_password
POSTGRES_DB=extracurriculares

# Backend
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-secure-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_DURATION_HOURS=168

# Google OAuth (login de profesores)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_INSTITUTION_DOMAIN=gi.edu.co

# Sincronización diaria de demográficos desde AppSheet
APPSHEET_APP_ID=xxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPSHEET_DEMOGRAFICOS_TABLE=Demograficos
APPSHEET_APPLICATION_ACCESS_KEY=replace-with-appsheet-key
APPSHEET_WEBHOOK_TOKEN=replace-with-webhook-token
NOVEDADES_SYNC_MINUTES=10

# Archivo de Google usado como fuente de AppSheet para estudiantes
GOOGLE_DRIVE_STUDENTS_FILE_NAME=DEMOGRAFICOS 2026-2027
# AppSheet lee la tabla Demograficos, cuyo origen es el archivo anterior.
# El Worker consulta AppSheet, no descarga directamente el archivo de Drive.
STUDENTS_SYNC_SOURCE=appsheet

# Frontend
VITE_API_URL=http://localhost:3000
